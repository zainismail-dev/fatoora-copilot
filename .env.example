# Copy this file to .env and fill in your values. Never commit .env.

# --- App ---
APP_URL=http://localhost:8000
SECRET_KEY=replace-with-a-long-random-string
COMPANY_NAME=Al Riyada Trading Co.
LARGE_AMOUNT_SAR=50000

# --- First manager account (created on first start) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-8-or-more-characters
ADMIN_NAME=Finance Manager

# --- AI providers, tried in order. Leave a key empty to skip it. ---
# Free key: https://aistudio.google.com  (Get API key)
GEMINI_API_KEY=
# One or more models, comma-separated. If one is busy or out of quota, the next is tried.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
# Free key: https://console.mistral.ai  (API Keys)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Gmail (optional): invoice inbox + approval and digest emails ---
# Use a Gmail App Password, not your normal password (see README).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
APPROVER_EMAIL=
EMAIL_POLL_SECONDS=60
